# Environment for the automated test suite.
#
# Laravel loads this instead of .env when APP_ENV=testing, which is what the
# `testing` Dockerfile target and phpunit.xml both set. Without an env file
# present, Laravel emits a file_get_contents() warning on every test, which
# PHPUnit 12 reports as a warning-level test result.
#
# Values here are safe, non-secret defaults for CI. phpunit.xml <env> entries
# take precedence over this file.

APP_NAME=Omnitrack
APP_ENV=testing
APP_KEY=base64:AckfSECXIvnK5r28GVIWUAxmbBSjTsmF/0rqJ4b8FTU=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=null
LOG_LEVEL=debug

# phpunit.xml sets DB_DATABASE=:memory: for a disposable database per test run.
DB_CONNECTION=sqlite
DB_DATABASE=":memory:"

QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array

MAIL_MAILER=array

# Left empty on purpose: tests must not call external APIs.
DEEPSEEK_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
HARNESS_SECRET_TOKEN=test-harness-token
