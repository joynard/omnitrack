APP_NAME=Omnitrack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL (Neon / Supabase)
# ---------------------------------------------------------------------------
# Neon and Supabase both hand you a single connection string. Paste it as
# DB_URL and leave the individual DB_* values alone, or fill them in manually.
#   Neon:     postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
#   Supabase: postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres
DB_CONNECTION=pgsql
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=omnitrack
DB_USERNAME=postgres
DB_PASSWORD=
# Neon/Supabase require TLS. Use "require" in production.
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Queue / cache / session — all database-backed (no Redis required)
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

# ---------------------------------------------------------------------------
# Google Sheets integration
# ---------------------------------------------------------------------------
# Inject the service-account JSON manually at storage/app/google/credentials.json.
# Until that file exists, ingestion is skipped with a warning instead of failing.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SHEET_ID=1lgivxc5ZnctCyX9swahxWjZMiq2tl7JSOEHvJ2Dxktw
GOOGLE_SHEET_RANGE=Sheet1!A2:H
GOOGLE_SHEET_NAME="Workspace Master Tracker"

# ---------------------------------------------------------------------------
# DeepSeek API
# ---------------------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60

# ---------------------------------------------------------------------------
# Login (single user)
# ---------------------------------------------------------------------------
# The account is created by the seeder. Set these, then run:
#   php artisan db:seed --force
OMNITRACK_USER_NAME=Omnitrack
OMNITRACK_USER_EMAIL=me@omnitrack.local
OMNITRACK_USER_PASSWORD=

# ---------------------------------------------------------------------------
# DeepSeek Harness agentic bridge
# ---------------------------------------------------------------------------
# Generate with: php -r "echo bin2hex(random_bytes(32));"
HARNESS_SECRET_TOKEN=

# ---------------------------------------------------------------------------
# Container behaviour
# ---------------------------------------------------------------------------
RUN_MIGRATIONS=true
MIGRATION_MAX_ATTEMPTS=5
