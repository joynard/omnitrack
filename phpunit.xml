<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AckfSECXIvnK5r28GVIWUAxmbBSjTsmF/0rqJ4b8FTU="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="HARNESS_SECRET_TOKEN" value="test-harness-token"/>
        <env name="DEEPSEEK_API_KEY" value=""/>
        <!-- WHY: a working copy legitimately holds the real service-account file at
             storage/app/google/credentials.json once the sync is configured, and a
             test that asserts the DEGRADED path (status "skipped") then fails on the
             developer's machine. Point the suite at a path that cannot exist so the
             outcome depends on the code, not on what happens to be on disk. -->
        <env name="GOOGLE_APPLICATION_CREDENTIALS" value="/nonexistent/omnitrack-test-credentials.json"/>
    </php>
</phpunit>
